{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "composer install --no-dev --optimize-autoloader || echo 'No composer.json'"
  },
  "deploy": {
    "startCommand": "frankenphp run --listen=0.0.0.0:$PORT",
    "healthcheckPath": "/api/v1/health",
    "healthcheckTimeout": 60
  },
  "variables": {
    "MYSQL_ADDON_HOST": "${MYSQL_ADDON_HOST}",
    "MYSQL_ADDON_DB": "${MYSQL_ADDON_DB}",
    "MYSQL_ADDON_USER": "${MYSQL_ADDON_USER}",
    "MYSQL_ADDON_PORT": "${MYSQL_ADDON_PORT}",
    "MYSQL_ADDON_PASSWORD": "${MYSQL_ADDON_PASSWORD}",
    "APP_ENV": "production",
    "APP_DEBUG": "false"
  }
}
