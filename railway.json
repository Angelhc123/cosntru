{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "buildCommand": "composer install --no-dev --optimize-autoloader || echo 'No composer.json'"
  },
  "deploy": {
    "startCommand": "cd public && php -S 0.0.0.0:$PORT -t .",
    "healthcheckPath": "/health_simple.php",
    "healthcheckTimeout": 60
  }
}
