# Base de datos MySQL - Clever Cloud
MYSQL_ADDON_HOST=tu-host-mysql.clever-cloud.com
MYSQL_ADDON_DB=tu_nombre_base_datos
MYSQL_ADDON_USER=tu_usuario
MYSQL_ADDON_PORT=3306
MYSQL_ADDON_PASSWORD=tu_password
MYSQL_ADDON_URI=mysql://usuario:password@host:3306/database

# Configuración de la aplicación
APP_ENV=production
APP_DEBUG=false
