# ========================================
# UPT CHAT SYSTEM - API GATEWAY
# Configuración de PRODUCCIÓN
# ========================================
# 
# IMPORTANTE: 
# - NO subir este archivo con valores reales al repositorio
# - Configurar estas variables en Railway/Render dashboard
# - Usar secrets seguros y diferentes a desarrollo
# ========================================

# ----------------------------------------
# APLICACIÓN
# ----------------------------------------
PORT=3000
NODE_ENV=production

# ----------------------------------------
# BASE DE DATOS
# ----------------------------------------
# Usar MongoDB Atlas o servicio managed
# Ejemplo Railway: mongodb://mongo:XXXXXXXXX@monorail.proxy.rlwy.net:12345/railway
MONGODB_URI=mongodb://user:STRONG_PASSWORD_HERE@production-host:27017/upt_chat_system?authSource=admin&ssl=true

# ----------------------------------------
# JWT (JSON Web Token)
# ----------------------------------------
# CRÍTICO: Generar un secret único y fuerte
# Comando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=GENERATE_A_VERY_STRONG_SECRET_HERE_MIN_64_CHARACTERS
JWT_EXPIRES_IN=7d

# ----------------------------------------
# MICROSERVICIOS
# ----------------------------------------
# URLs de producción (Railway/Render internal URLs)
CHAT_SERVICE_URL=https://chat-service-production.up.railway.app
NLP_SERVICE_URL=https://nlp-service-production.up.railway.app
KNOWLEDGE_BASE_SERVICE_URL=https://knowledge-base-production.up.railway.app
ANALYTICS_SERVICE_URL=https://analytics-service-production.up.railway.app
NOTIFICATION_SERVICE_URL=https://notification-service-production.up.railway.app

# ----------------------------------------
# RATE LIMITING
# ----------------------------------------
# Más restrictivo en producción
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ----------------------------------------
# CORS (Cross-Origin Resource Sharing)
# ----------------------------------------
# Solo orígenes de producción
ALLOWED_ORIGINS=https://chat.upt.edu.pe,https://app.upt.edu.pe

# ----------------------------------------
# LOGGING
# ----------------------------------------
# Solo warn y error en producción para rendimiento
LOG_LEVEL=warn

# ----------------------------------------
# INTEGRACIÓN UPT
# ----------------------------------------
# Configurar cuando se conecte con sistemas reales de UPT
UPT_LDAP_URL=ldap://ldap.upt.edu.pe:389
UPT_LDAP_BIND_DN=cn=admin,dc=upt,dc=edu,dc=pe
UPT_LDAP_BIND_PASSWORD=STRONG_LDAP_PASSWORD_HERE
UPT_DATABASE_URL=postgres://upt_user:STRONG_PASSWORD@upt-db.internal:5432/upt_production

# ----------------------------------------
# MONITOREO (OPCIONAL)
# ----------------------------------------
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# DATADOG_API_KEY=xxxxx
# NEW_RELIC_LICENSE_KEY=xxxxx
