# Environment
ENVI# NLP Configuration
SPACY_MODEL=es_core_news_sm

# DialogFlow Configuration (usando DialogFlow ES gratuito)
USE_DIALOGFLOW=False
GOOGLE_PROJECT_ID=
GOOGLE_CREDENTIALS_PATH=
DIALOGFLOW_LANGUAGE_CODE=es

# DialogFlow ES (alternativa gratuita - sin cuota de proyectos)
USE_DIALOGFLOW_ES=True
DIALOGFLOW_ES_ACCESS_TOKEN=obtener-de-dialogflow-console

# Confidence thresholds
MIN_CONFIDENCE=0.6
HIGH_CONFIDENCE=0.8
DIALOGFLOW_CONFIDENCE_THRESHOLD=0.7T=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8001

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/nlp-service.log

# CORS Origins (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000,http://localhost:5173

# Data paths
INTENTS_DATA_PATH=data/intents.json
FAQS_DATA_PATH=data/faqs.json

# NLP Configuration
SPACY_MODEL=es_core_news_sm

# Confidence Thresholds
MIN_CONFIDENCE=0.6
