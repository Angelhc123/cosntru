# Environment
ENVIRONMENT=production
DEBUG=False

# Server
HOST=0.0.0.0
PORT=8001

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/nlp-service.log

# CORS Origins (Railway domains)
CORS_ORIGINS=*

# NLP Configuration
SPACY_MODEL=es_core_news_sm

# DialogFlow Configuration (desactivado por defecto)
USE_DIALOGFLOW=False
GOOGLE_PROJECT_ID=upt-chat-fhps
GOOGLE_CREDENTIALS_PATH=credentials/dialogflow-credentials.json
DIALOGFLOW_LANGUAGE_CODE=es

# Admin
ADMIN_EMAIL=admin@upt.pe

# Data paths
INTENTS_DATA_PATH=data/intents.json
FAQS_DATA_PATH=data/faqs.json

# NLP Configuration
SPACY_MODEL=es_core_news_sm

# Confidence Thresholds
MIN_CONFIDENCE=0.6
HIGH_CONFIDENCE=0.8
