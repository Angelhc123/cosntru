# API Gateway Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/upt_chat_system

# JWT Configuration
JWT_SECRET=upt_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Services URLs
CHAT_SERVICE_URL=http://localhost:3001
NLP_SERVICE_URL=http://localhost:3002
KNOWLEDGE_BASE_SERVICE_URL=http://localhost:3003
ANALYTICS_SERVICE_URL=http://localhost:3004
NOTIFICATION_SERVICE_URL=http://localhost:3005

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Logging
LOG_LEVEL=info