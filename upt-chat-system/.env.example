# ===================================
# UPT CHAT SYSTEM - ENVIRONMENT VARIABLES
# ===================================

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/upt_chat_system?retryWrites=true&w=majority

# Application Environment
NODE_ENV=production

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS Origins (comma separated)
ALLOWED_ORIGINS=https://your-frontend-domain.com,http://localhost:3000,http://localhost:4200

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Railway Configuration (opcional)
RAILWAY_STATIC_URL=
RAILWAY_PUBLIC_DOMAIN=

# Service Ports (Railway will override these)
DB_SEEDER_PORT=3001
API_GATEWAY_PORT=3000
CHAT_SERVICE_PORT=3002
NLP_SERVICE_PORT=3003
KNOWLEDGE_BASE_PORT=3004
ANALYTICS_PORT=3005
NOTIFICATIONS_PORT=3006