@startuml RF004_Secuencia_Recuperacion_Contrasena
!theme cerulean-outline

title Diagrama de Secuencia - RF004\nRecuperación de Contraseña por Email Personal

actor "Usuario UPT" as user
participant "Chatbox\n(Frontend)" as chatbox
participant "API Gateway\n:3000" as gateway
participant "NLP Service\n:8001" as nlp
participant "DialogFlow\nES" as dialogflow
participant "Webhook\nController" as webhook
participant "Password Reset\nService" as passreset
participant "MySQL\nConnection" as mysql
participant "MongoDB" as mongo
participant "Notification\nService :3005" as notif
participant "Gmail\nSMTP" as gmail
database "MySQL UPT" as mysqldb
database "MongoDB" as mongodb

== Fase 1: Inicio del Flujo ==

user -> chatbox : "olvidé mi contraseña"
activate chatbox

chatbox -> gateway : POST /api/v1/nlp/process\n{message: "olvidé mi contraseña",\nsession_id: "xxx"}
activate gateway

gateway -> nlp : POST /api/v1/nlp/process
activate nlp

nlp -> dialogflow : detectIntent()\n"olvidé mi contraseña"
activate dialogflow

dialogflow -> dialogflow : Detecta intent:\n"Contraseña Olvidada"
dialogflow -> webhook : POST /webhook\n{intent: "Contraseña Olvidada",\nqueryText: "olvidé mi contraseña"}
activate webhook

webhook -> webhook : extract_email_from_text()\n❌ No encuentra email

webhook -> webhook : Crear contexto:\n"awaiting-email"\nlifespanCount: 3

webhook --> dialogflow : {\nfulfillmentText: "Para ayudarte...\nproporciona tu correo",\noutputContexts: [awaiting-email]\n}
deactivate webhook

dialogflow --> nlp : Intent response +\ncontextos
deactivate dialogflow

nlp --> gateway : {\nresponse: "Para ayudarte...",\nvalidation_state: "awaiting_email"\n}
deactivate nlp

gateway --> chatbox : Response
deactivate gateway

chatbox -> user : 🤖 "Para ayudarte a recuperar tu\ncontraseña, necesito validar tu\nidentidad. Por favor, proporciona\ntu correo electrónico..."
deactivate chatbox

== Fase 2: Usuario Proporciona Email ==

user -> chatbox : "xxdescixx@gmail.com"
activate chatbox

chatbox -> gateway : POST /api/v1/nlp/process\n{message: "xxdescixx@gmail.com",\nsession_id: "xxx"}
activate gateway

gateway -> nlp : POST /api/v1/nlp/process
activate nlp

nlp -> dialogflow : detectIntent()\n"xxdescixx@gmail.com"
activate dialogflow

dialogflow -> dialogflow : ❌ Default Fallback Intent\nconfidence: 0.0
note right: DialogFlow no reconoce\nel email como intent

dialogflow --> nlp : Fallback response
deactivate dialogflow

nlp -> nlp : 📧 **DETECCIÓN DE EMAIL**\nemail_pattern REGEX\nMatches: ["xxdescixx@gmail.com"]
note right
  **NUEVO CÓDIGO:**
  Detecta emails sin
  depender de DialogFlow
end note

nlp -> webhook : handle_password_recovery\n_with_email(\nemail="xxdescixx@gmail.com",\nsession="xxx")
activate webhook

== Fase 3: Verificación de Email ==

webhook -> gateway : POST /api/v1/users/verify-email\n{email: "xxdescixx@gmail.com"}
activate gateway

gateway -> mysql : verifyEmailPersonal()
activate mysql

mysql -> mysqldb : SELECT u.*, d.*\nFROM usuarios u\nJOIN datos_personales d\nWHERE d.email_personal = ?
activate mysqldb

mysqldb --> mysql : {\nid: 1,\nusuario: "xxdescixx",\nnombre_completo: "Desci Test Usuario",\nemail: "xxdescixx@gmail.com"\n}
deactivate mysqldb

mysql --> gateway : {exists: true,\nuser_id: "xxdescixx",\nname: "Desci Test Usuario"}
deactivate mysql

gateway --> webhook : Email verificado ✅
deactivate gateway

== Fase 4: Generación de Token ==

webhook -> gateway : POST /api/v1/password-reset/initiate\n{email: "xxdescixx@gmail.com",\nsession_id: "xxx"}
activate gateway

gateway -> passreset : initiatePasswordReset()
activate passreset

passreset -> passreset : generateToken()\ncrypto.randomBytes(32)\n→ "a6185cbf68ce..."

passreset -> mongodb : PasswordResetToken.create({\ntoken: "a6185cbf...",\nemail: "xxdescixx@gmail.com",\nsession_id: "xxx",\nexpires_at: now + 1 hour,\nused: false\n})
activate mongodb

mongodb --> passreset : Token guardado ✅
deactivate mongodb

passreset -> mongodb : ValidationNotification.create({\nsession_id: "xxx",\nstatus: "pending",\nmessage: "Esperando confirmación"\n})
activate mongodb

mongodb --> passreset : Notificación creada ✅
deactivate mongodb

== Fase 5: Envío de Email ==

passreset -> notif : POST /api/notifications/email/\npassword-reset-confirmation\n{\nto: "xxdescixx@gmail.com",\nuserName: "Desci Test Usuario",\nconfirmationUrl: "http://localhost:3000/\napi/v1/password-reset/confirm/a6185cbf..."\n}
activate notif

notif -> notif : Generar HTML\ncon template

notif -> gmail : SMTP Send\nFrom: dragonfaita@gmail.com\nTo: xxdescixx@gmail.com\nSubject: "Confirmación de\nRecuperación de Contraseña - UPT"
activate gmail

gmail -> user : 📧 Email entregado
note right
  Email contiene:
  - Saludo personalizado
  - Botón "Confirmar Recuperación"
  - Link alternativo
  - Aviso de expiración (1 hora)
end note

gmail --> notif : Message ID:\n<e8f91acc-abda...@gmail.com>
deactivate gmail

notif --> passreset : ✅ Email enviado
deactivate notif

passreset --> gateway : {success: true,\ntoken: "a6185cbf...",\nmessage: "Email de confirmación enviado"}
deactivate passreset

gateway --> webhook : Success ✅
deactivate gateway

webhook --> nlp : {\nfulfillmentText: "Perfecto,\nDesci Test Usuario. He enviado\nun correo electrónico a\nxxdescixx@gmail.com con las\ninstrucciones..."\n}
deactivate webhook

nlp --> gateway : Response
deactivate nlp

gateway --> chatbox : Response
deactivate gateway

chatbox -> user : 🤖 "Perfecto, Desci Test Usuario.\nHe enviado un correo electrónico\na xxdescixx@gmail.com con las\ninstrucciones para recuperar\ntu contraseña..."
deactivate chatbox

== Fase 6: Confirmación del Usuario ==

user -> user : 📧 Abre email
user -> user : 🖱️ Click en\n"Confirmar Recuperación"

user -> gateway : GET /api/v1/password-reset/\nconfirm/a6185cbf68ce...
activate gateway

gateway -> passreset : confirmPasswordReset(\ntoken: "a6185cbf...")
activate passreset

passreset -> mongodb : PasswordResetToken.findOne({\ntoken: "a6185cbf...",\nused: false\n})
activate mongodb

mongodb --> passreset : Token encontrado ✅\nexpires_at: valid\nused: false
deactivate mongodb

passreset -> passreset : Verificar:\n✅ Token existe\n✅ No usado\n✅ No expirado

passreset -> passreset : generateSecurePassword()\n→ "Xy9#kL2mP4qW"\n(12 caracteres seguros)

passreset -> mysqldb : UPDATE usuarios\nSET password = hash("Xy9#kL2mP4qW")\nWHERE usuario = "xxdescixx"
activate mysqldb

mysqldb --> passreset : ✅ Contraseña actualizada
deactivate mysqldb

passreset -> mongodb : PasswordResetToken.updateOne({\ntoken: "a6185cbf..."\n}, {used: true})
activate mongodb

mongodb --> passreset : ✅ Token marcado como usado
deactivate mongodb

passreset -> mongodb : ValidationNotification.updateOne({\nsession_id: "xxx"\n}, {status: "confirmed"})
activate mongodb

mongodb --> passreset : ✅ Estado actualizado
deactivate mongodb

passreset -> notif : POST /api/notifications/email/\npassword-reset-complete\n{\nto: "xxdescixx@gmail.com",\nuserName: "Desci Test Usuario",\nnewPassword: "Xy9#kL2mP4qW"\n}
activate notif

notif -> gmail : SMTP Send\nNueva contraseña generada
activate gmail

gmail -> user : 📧 Email con nueva contraseña
deactivate gmail

notif --> passreset : ✅ Email enviado
deactivate notif

passreset --> gateway : {success: true,\nmessage: "Contraseña restablecida"}
deactivate passreset

gateway -> user : **Página HTML de éxito**\n"✅ Tu contraseña ha sido\nrestablecida exitosamente.\nRevisa tu email para\nla nueva contraseña."
deactivate gateway

== Fase 7: Usuario Accede con Nueva Contraseña ==

user -> user : 📧 Revisa email con\nnueva contraseña

user -> chatbox : Inicia sesión con\nnueva contraseña
activate chatbox

chatbox -> gateway : Autenticación
activate gateway

gateway -> mysqldb : Verificar credenciales
activate mysqldb

mysqldb --> gateway : ✅ Autenticación exitosa
deactivate mysqldb

gateway --> chatbox : ✅ Sesión iniciada
deactivate gateway

chatbox -> user : ✅ Acceso concedido
deactivate chatbox

note over user, mongodb
  **Flujo RF004 completado exitosamente**
  
  ✅ Email verificado
  ✅ Token generado y validado
  ✅ Email de confirmación enviado
  ✅ Contraseña restablecida
  ✅ Usuario notificado
  ✅ Acceso restaurado
end note

@enduml
