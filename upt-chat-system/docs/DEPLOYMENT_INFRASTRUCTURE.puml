@startuml Deployment_Infrastructure
!theme superhero-outline

title Diagrama de Despliegue\nInfraestructura del Sistema de Chat UPT

' ============================================
' DESARROLLO (LOCALHOST)
' ============================================
node "Máquina de Desarrollo (Pop!_OS Linux)" as DevMachine {
  
  node "Frontend Server" as FrontendNode <<Apache/PHP>> {
    artifact "PHP 8.x Runtime" as PHP8
    artifact "HTML/CSS/JS Files" as StaticFiles
    
    component "PHP Application" {
      [index.html]
      [login.php]
      [dashboard.php]
      [test_password_recovery.html]
      [chatbox.js]
      [api_verify_email.php]
    }
    
    note right of FrontendNode
      **Puerto:** 8000
      **Proceso:** php -S localhost:8000
      **Log:** proyectotest/public/frontend.log
      
      **Archivos servidos:**
      - Widget chatbox
      - Páginas de prueba
      - API PHP legacy
    end note
  }
  
  node "API Gateway Server" as GatewayNode <<Node.js>> {
    artifact "Node.js v18+" as NodeJS
    artifact "NestJS Framework" as NestJS
    
    component "API Gateway Application" {
      [Controllers]
      [Services]
      [Repositories]
      [Middlewares]
      [Guards]
    }
    
    note right of GatewayNode
      **Puerto:** 3000
      **Proceso:** npm run start:prod
      **Log:** api-gateway/api-gateway.log
      
      **Endpoints principales:**
      - /api/v1/users/*
      - /api/v1/password-reset/*
      - /api/v1/chat-sessions/*
      - /api/v1/nlp/*
    end note
  }
  
  node "NLP Service Server" as NLPNode <<Python>> {
    artifact "Python 3.10+" as Python
    artifact "FastAPI + Uvicorn" as FastAPI
    
    component "NLP Application" {
      [Controllers]
      [Use Cases]
      [Domain Services]
      [DialogFlow Client]
      [Local NLP Engine]
    }
    
    note right of NLPNode
      **Puerto:** 8001
      **Proceso:** uvicorn main:app --host 0.0.0.0 --port 8001
      **Log:** nlp-service/nlp-service.log
      
      **Endpoints:**
      - /api/v1/nlp/process
      - /webhook (para DialogFlow)
      - /health
    end note
  }
  
  node "Notification Service Server" as NotifNode <<Node.js>> {
    artifact "Node.js v18+" as NodeJS2
    artifact "NestJS + NodeMailer" as NestJS2
    
    component "Notification Application" {
      [Email Controller]
      [Email Service]
      [Template Engine]
      [SMTP Client]
    }
    
    note right of NotifNode
      **Puerto:** 3005
      **Proceso:** npm run start:dev
      **Log:** notification-service/notification-service.log
      
      **Endpoints:**
      - /api/notifications/email/*
    end note
  }
  
  node "ngrok Tunnel" as NgrokNode <<Network Proxy>> {
    artifact "ngrok v3" as Ngrok
    
    component "Tunnel Configuration" {
      [HTTP Tunnel]
      [Dashboard]
    }
    
    note right of NgrokNode
      **Puerto Dashboard:** 4040
      **Proceso:** ngrok http 8001
      **Auth Token:** 34LHmRKfW4opTbOjfCwuqlEHxRd...
      
      **URL Pública:**
      https://pentangular-laree-
      floggingly.ngrok-free.dev
      
      **Propósito:**
      Exponer webhook de NLP Service
      para que DialogFlow pueda llamarlo
    end note
  }
}

' ============================================
' CLOUD DATABASES
' ============================================
cloud "MongoDB Cloud" as MongoCloud <<Atlas>> {
  database "upt_chat_system" as MongoDBAtlas {
    collections [
      users
      chat_sessions
      messages
      password_reset_tokens
      validation_notifications
    ]
  }
  
  note right of MongoCloud
    **Proveedor:** MongoDB Atlas
    **Región:** Cercana a Perú
    **Plan:** Free Tier (512 MB)
    
    **Conexión:**
    mongodb+srv://...
    
    **Características:**
    - Réplica automática
    - Backups diarios
    - SSL/TLS enabled
  end note
}

cloud "CleverCloud MySQL" as MySQLCloud <<PaaS>> {
  database "bj7lnbakskgcgngpmtma" as MySQLClever {
    tables [
      usuarios
      datos_personales
      carreras
      ciclos
      cursos
    ]
  }
  
  note right of MySQLCloud
    **Proveedor:** CleverCloud
    **Host:** bj7lnbakskgcgngpmtma-mysql
              .services.clever-cloud.com
    **Puerto:** 3306
    **Plan:** Free Tier
    
    **Base de datos UPT existente**
    Solo lectura + UPDATE password
  end note
}

' ============================================
' EXTERNAL CLOUD SERVICES
' ============================================
cloud "Google Cloud Platform" as GCP {
  component "DialogFlow ES" as DialogFlowService {
    [Agent: upt-chatbox]
    [Intents]
    [Entities]
    [Contexts]
    [Fulfillment Webhook]
  }
  
  note right of DialogFlowService
    **Project ID:** upt-chatbox
    **Region:** global
    
    **Credenciales:**
    Service Account JSON
    
    **Webhook URL:**
    https://pentangular-laree-
    floggingly.ngrok-free.dev/webhook
  end note
}

cloud "Gmail SMTP" as GmailCloud {
  component "Gmail Server" as GmailServer {
    [SMTP Service]
    [Authentication]
  }
  
  note right of GmailCloud
    **Host:** smtp.gmail.com
    **Puerto:** 587 (STARTTLS)
    
    **Cuenta:** dragonfaita@gmail.com
    **App Password:** zhhh ipvr gyty znea
    
    **Propósito:**
    Enviar emails de recuperación
    de contraseña
  end note
}

' ============================================
' DEPLOYMENT SCRIPTS
' ============================================
node "Scripts de Gestión" as Scripts {
  artifact "start_all.sh" as StartScript {
    Inicia todos los servicios
    en orden:
    1. ngrok
    2. API Gateway
    3. NLP Service
    4. Notification Service
    5. Frontend PHP
  }
  
  artifact "stop_all.sh" as StopScript {
    Detiene todos los servicios
    y libera puertos
  }
  
  artifact "status.sh" as StatusScript {
    Muestra estado de todos
    los servicios con PIDs
    y URLs
  }
}

' ============================================
' CONFIGURATION FILES
' ============================================
folder "Configuration" as ConfigFolder {
  file ".env (API Gateway)" as EnvGW
  file ".env (NLP Service)" as EnvNLP
  file ".env (Notification)" as EnvNotif
  file "credentials/dialogflow-credentials.json" as DFCreds
}

' ============================================
' RELATIONSHIPS
' ============================================

' Frontend connections
FrontendNode --> GatewayNode : HTTP :3000\nREST API Calls

' API Gateway connections
GatewayNode --> NLPNode : HTTP :8001\nProcess NLP
GatewayNode --> NotifNode : HTTP :3005\nSend Emails
GatewayNode --> MongoDBAtlas : MongoDB Protocol\n:27017
GatewayNode --> MySQLClever : MySQL Protocol\n:3306

' NLP Service connections
NLPNode --> DialogFlowService : gRPC/HTTPS\nDetect Intent
NLPNode --> MongoDBAtlas : MongoDB Protocol\nContext Storage
NLPNode --> GatewayNode : HTTP :3000\nAPI Calls

' DialogFlow webhook
DialogFlowService --> NgrokNode : HTTPS\nWebhook Callbacks
NgrokNode --> NLPNode : HTTP :8001\n/webhook

' Notification Service
NotifNode --> GmailServer : SMTP :587\nSend Emails

' Configuration
EnvGW ..> GatewayNode : configure
EnvNLP ..> NLPNode : configure
EnvNotif ..> NotifNode : configure
DFCreds ..> NLPNode : authenticate

' Scripts
StartScript ..> FrontendNode : start
StartScript ..> GatewayNode : start
StartScript ..> NLPNode : start
StartScript ..> NotifNode : start
StartScript ..> NgrokNode : start

' ============================================
' NETWORK ZONES
' ============================================
rectangle "Local Network (localhost)" {
  FrontendNode
  GatewayNode
  NLPNode
  NotifNode
  NgrokNode
}

rectangle "Internet" {
  MongoCloud
  MySQLCloud
  GCP
  GmailCloud
}

' ============================================
' LEGEND
' ============================================
legend right
  **Puertos Locales:**
  - Frontend: 8000
  - API Gateway: 3000
  - NLP Service: 8001
  - Notification: 3005
  - ngrok Dashboard: 4040
  
  **Protocolos:**
  - HTTP/HTTPS: REST APIs
  - MongoDB: Base de datos NoSQL
  - MySQL: Base de datos SQL
  - SMTP: Envío de emails
  - gRPC: DialogFlow API
  
  **Gestión de Procesos:**
  - ./start_all.sh: Iniciar sistema
  - ./stop_all.sh: Detener sistema
  - ./status.sh: Ver estado
  
  **Logs:**
  - Frontend: proyectotest/public/frontend.log
  - API Gateway: services/api-gateway/api-gateway.log
  - NLP Service: services/nlp-service/nlp-service.log
  - Notification: services/notification-service/notification-service.log
endlegend

@enduml
