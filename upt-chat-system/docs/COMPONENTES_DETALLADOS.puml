@startuml Componentes_Detallados_UPT_Chat
!theme vibrant

title Diagrama de Componentes Detallado\nSistema de Chat UPT con RF004

skinparam componentStyle rectangle

' ============================================
' FRONTEND LAYER
' ============================================
package "Frontend Layer - Puerto 8000" {
  [PHP Server] as PHP
  
  component "Static Files" {
    [index.html]
    [login.php]
    [dashboard.php]
    [test_password_recovery.html]
  }
  
  component "JavaScript Modules" {
    [chatbox.js] as chatboxjs
    [script.js]
  }
  
  component "CSS Styles" {
    [chatbox.css]
    [style.css]
  }
  
  component "PHP Controllers" {
    [AuthController.php]
    [api_verify_email.php]
  }
}

' ============================================
' API GATEWAY LAYER
' ============================================
package "API Gateway - NestJS Puerto 3000" {
  
  component "Presentation Layer" {
    [UsersController] as UsersCtrl
    [PasswordResetController] as PassResetCtrl
    [ChatSessionsController] as ChatCtrl
    [NlpController] as NlpCtrlGW
    [HealthController] as HealthCtrl
    [ConfigController] as ConfigCtrl
  }
  
  component "Application Layer" {
    [PasswordResetService] as PassResetSvc
    [NlpService] as NlpSvcGW
    [GetUserProfileUseCase]
    [StartChatSessionUseCase]
    [EndChatSessionUseCase]
    [ValidateUserForChatUseCase]
  }
  
  component "Domain Layer" {
    [UserDomainService]
    [ChatSessionDomainService]
  }
  
  component "Infrastructure Layer" {
    [MySQLConnectionService] as MySQLSvc
    [MongoUserRepository]
    [MongoChatSessionRepository]
    [JwtStrategy]
    [AppLoggerService]
  }
  
  component "DTOs" {
    [InitiateResetDto]
    [ConfirmResetDto]
    [VerifyEmailDto]
    [ProcessMessageDto]
  }
}

' ============================================
' NLP SERVICE LAYER
' ============================================
package "NLP Service - Python FastAPI Puerto 8001" {
  
  component "Presentation Controllers" {
    [NlpController] as NlpCtrl
    [WebhookController] as WebhookCtrl
  }
  
  component "Application Use Cases" {
    [ProcessMessageUseCase] as ProcessMsgUC
    [DetectIntentUseCase]
  }
  
  component "Domain Services" {
    [HybridNLPService] as HybridNLP
    [ContextManagerService] as ContextMgr
    [DialogFlowService] as DialogFlowSvc
    [LocalNLPEngine]
  }
  
  component "Infrastructure" {
    [DialogFlowClient]
    [MongoDBClient]
    [ApiGatewayClient]
  }
  
  component "Domain Entities" {
    [Message]
    [Intent]
    [Conversation]
    [Context]
    [Confidence]
  }
  
  component "Detectors" {
    [SensitiveQueryDetector]
    [EmailExtractor]
  }
}

' ============================================
' NOTIFICATION SERVICE LAYER
' ============================================
package "Notification Service - NestJS Puerto 3005" {
  
  component "Controllers" {
    [EmailController] as EmailCtrl
    [NotificationController]
  }
  
  component "Services" {
    [EmailService] as EmailSvc
    [TemplateService]
  }
  
  component "Templates" {
    [password-reset-confirmation.hbs]
    [password-reset-complete.hbs]
    [welcome-email.hbs]
  }
  
  component "Providers" {
    [NodeMailerProvider]
    [SMTPConfigProvider]
  }
}

' ============================================
' EXTERNAL SERVICES
' ============================================
cloud "External Services" {
  [Google DialogFlow ES API] as DialogFlowAPI
  [Gmail SMTP Server] as GmailSMTP
}

' ============================================
' ngrok TUNNEL
' ============================================
cloud "ngrok - Puerto 4040" {
  [ngrok Tunnel] as ngrok
  note right of ngrok
    HTTPS Tunnel
    URL: https://pentangular-laree-
    floggingly.ngrok-free.dev
    
    Expone /webhook de NLP Service
    a internet para DialogFlow
  end note
}

' ============================================
' DATA LAYER
' ============================================
package "Data Layer" {
  
  database "MongoDB Cloud" as MongoDB {
    collections [
      users
      chat_sessions
      messages
      password_reset_tokens
      validation_notifications
    ]
  }
  
  database "MySQL UPT (CleverCloud)" as MySQLDB {
    tables [
      usuarios
      datos_personales
      carreras
      ciclos
    ]
  }
}

' ============================================
' CONFIGURATION
' ============================================
package "Configuration" {
  file ".env (API Gateway)" as EnvGW {
    PORT=3000
    MONGODB_URI=mongodb://...
    MYSQL_HOST=bj7lnbakskgcgngpmtma...
    JWT_SECRET=...
    NLP_SERVICE_URL=http://localhost:8001
    NOTIFICATION_SERVICE_URL=http://localhost:3005
  }
  
  file ".env (NLP Service)" as EnvNLP {
    PORT=8001
    DIALOGFLOW_PROJECT_ID=upt-chatbox
    DIALOGFLOW_CREDENTIALS=credentials/...
    API_GATEWAY_URL=http://localhost:3000
  }
  
  file ".env (Notification)" as EnvNotif {
    PORT=3005
    EMAIL_HOST=smtp.gmail.com
    EMAIL_USER=dragonfaita@gmail.com
    EMAIL_PASSWORD=zhhh ipvr gyty znea
  }
}

' ============================================
' RELATIONSHIPS - FRONTEND
' ============================================
[index.html] --> chatboxjs
chatboxjs --> PHP : HTTP Requests
PHP --> UsersCtrl : REST API
PHP --> ChatCtrl : REST API

' ============================================
' RELATIONSHIPS - API GATEWAY
' ============================================
UsersCtrl --> MySQLSvc : verify email
PassResetCtrl --> PassResetSvc : initiate/confirm
ChatCtrl --> ChatSessionDomainService
NlpCtrlGW --> NlpSvcGW : process message

PassResetSvc --> MySQLSvc : verify user
PassResetSvc --> MongoDB : save tokens
PassResetSvc --> EmailCtrl : send email

MySQLSvc --> MySQLDB : SQL queries
MongoUserRepository --> MongoDB : CRUD
MongoChatSessionRepository --> MongoDB : CRUD

NlpSvcGW --> NlpCtrl : HTTP Client

' ============================================
' RELATIONSHIPS - NLP SERVICE
' ============================================
NlpCtrl --> ProcessMsgUC : execute
WebhookCtrl --> ProcessMsgUC : webhook handler

ProcessMsgUC --> HybridNLP : detect intent
ProcessMsgUC --> ContextMgr : manage context
ProcessMsgUC --> SensitiveQueryDetector : detect
ProcessMsgUC --> EmailExtractor : extract email

HybridNLP --> DialogFlowSvc : primary
HybridNLP --> LocalNLPEngine : fallback

DialogFlowSvc --> DialogFlowClient
DialogFlowClient --> DialogFlowAPI : gRPC/REST
DialogFlowAPI --> ngrok : webhook callback
ngrok --> WebhookCtrl : HTTPS

WebhookCtrl --> ApiGatewayClient : verify email
ApiGatewayClient --> UsersCtrl : HTTP

ProcessMsgUC --> MongoDBClient : save context
MongoDBClient --> MongoDB

' ============================================
' RELATIONSHIPS - NOTIFICATION
' ============================================
EmailCtrl --> EmailSvc : send email
EmailSvc --> TemplateService : render template
EmailSvc --> NodeMailerProvider : SMTP
NodeMailerProvider --> GmailSMTP : port 587

' ============================================
' RELATIONSHIPS - CONFIGURATION
' ============================================
EnvGW ..> MySQLSvc : configure
EnvGW ..> PassResetSvc : configure
EnvNLP ..> DialogFlowSvc : configure
EnvNotif ..> EmailSvc : configure

' ============================================
' NOTES
' ============================================
note bottom of MongoDB
  **Collections:**
  - users: Usuario cache
  - chat_sessions: Sesiones activas
  - messages: Historial chat
  - password_reset_tokens: Tokens RF004
  - validation_notifications: Estados
  
  **Índices únicos:**
  - password_reset_tokens.token
  - validation_notifications.session_id
end note

note bottom of MySQLDB
  **Base de datos UPT existente**
  
  Campos importantes:
  - usuarios.usuario (username)
  - usuarios.password (hash)
  - datos_personales.email_personal
  - datos_personales.email_institucional
  
  **Solo operaciones READ**
  Excepto: UPDATE password (RF004)
end note

note right of WebhookCtrl
  **Flujo RF004:**
  
  1. Detecta intent "Contraseña Olvidada"
  2. Crea contexto "awaiting-email"
  3. Extrae email con REGEX
  4. Verifica email en MySQL
  5. Genera token único
  6. Envía email de confirmación
  7. Usuario confirma → nueva contraseña
end note

note right of HybridNLP
  **Estrategia Híbrida:**
  
  Primary: DialogFlow ES
  - Intent detection
  - Context management
  - Webhook fulfillment
  
  Fallback: Local NLP
  - Keyword matching
  - Pattern recognition
  - Confidence scoring
  
  **Detección de emails:**
  REGEX independiente de
  DialogFlow para mayor
  confiabilidad
end note

@enduml
