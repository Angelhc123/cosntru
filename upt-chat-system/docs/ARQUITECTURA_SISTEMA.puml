@startuml Arquitectura_UPT_Chat_System
!define ICONURL https://raw.githubusercontent.com/tupadr3/plantuml-icon-font-sprites/v2.4.0
!include ICONURL/common.puml
!include ICONURL/font-awesome-5/user.puml
!include ICONURL/font-awesome-5/chrome.puml
!include ICONURL/font-awesome-5/server.puml
!include ICONURL/font-awesome-5/database.puml
!include ICONURL/font-awesome-5/envelope.puml

title Arquitectura de Microservicios - Sistema de Chat UPT\nRF004 - Recuperación de Contraseña

skinparam {
  BackgroundColor white
  ArrowColor #2C3E50
  BorderColor #2C3E50
  ComponentBackgroundColor #ECF0F1
  ComponentBorderColor #2980B9
  DatabaseBackgroundColor #E8F8F5
  DatabaseBorderColor #27AE60
  CloudBackgroundColor #FEF9E7
  CloudBorderColor #F39C12
  ActorBackgroundColor #FADBD8
  ActorBorderColor #E74C3C
}

' ============================================
' CAPA DE PRESENTACIÓN
' ============================================
package "Capa de Presentación" as presentation #LightBlue {
  
  actor "Usuario UPT" as user #Pink
  
  rectangle "Frontend" as frontend #LightYellow {
    component [Widget Chatbox\n(JavaScript)] as chatbox
    component [Test Pages\n(HTML)] as testpages
    component [PHP Server\n:8000] as phpserver
  }
  
  cloud "Túnel HTTPS" as tunnel #Orange {
    component [ngrok\n:4040] as ngrok
    note right of ngrok
      URL Pública:
      https://pentangular-laree-
      floggingly.ngrok-free.dev
    end note
  }
}

' ============================================
' CAPA DE API GATEWAY
' ============================================
package "API Gateway" as gateway_layer #LightGreen {
  rectangle "API Gateway\n(NestJS :3000)" as apigateway {
    component [Users Controller] as usersctrl
    component [Password Reset\nController] as passctrl
    component [Chat Sessions\nController] as chatctrl
    component [NLP Controller] as nlpctrl
    component [Health Controller] as healthctrl
    
    rectangle "Services" as gateway_services {
      component [MySQL Connection\nService] as mysqlservice
      component [Password Reset\nService] as passservice
      component [NLP Service\nClient] as nlpservice_client
    }
  }
}

' ============================================
' CAPA DE MICROSERVICIOS
' ============================================
package "Microservicios" as microservices #LightCyan {
  
  rectangle "NLP Service\n(Python FastAPI :8001)" as nlpservice {
    component [NLP Controller] as nlp_ctrl
    component [Webhook Controller\n(DialogFlow)] as webhook_ctrl
    
    rectangle "Use Cases" as nlp_usecases {
      component [Process Message\nUse Case] as process_msg
    }
    
    rectangle "Domain Services" as nlp_domain {
      component [Hybrid NLP Service] as hybrid_nlp
      component [DialogFlow Service] as dialogflow
      component [Local NLP Engine] as local_nlp
      component [Context Manager] as context_mgr
    }
  }
  
  rectangle "Notification Service\n(NestJS :3005)" as notifservice {
    component [Email Controller] as email_ctrl
    component [Email Service\n(NodeMailer)] as email_service
    
    note right of email_service
      Gmail SMTP
      dragonfaita@gmail.com
      Password: zhhh ipvr gyty znea
    end note
  }
}

' ============================================
' SERVICIOS EXTERNOS
' ============================================
cloud "Servicios Externos" as external #LightGray {
  component [Google DialogFlow ES] as dialogflow_api
  component [Gmail SMTP\nServer] as gmail
}

' ============================================
' CAPA DE DATOS
' ============================================
package "Capa de Datos" as data_layer #LightSalmon {
  database "MongoDB\n(Cloud)" as mongodb {
    component [Chat Sessions] as sessions_col
    component [Messages] as messages_col
    component [Users Cache] as users_col
    component [Password Reset\nTokens] as tokens_col
    component [Validation\nNotifications] as notif_col
  }
  
  database "MySQL UPT\n(CleverCloud)" as mysql {
    component [usuarios] as usuarios_table
    component [Datos personales] as datos_table
    
    note right of mysql
      Host: bj7lnbakskgcgngpmtma
      -mysql.services.clever-cloud.com
      
      Usuarios de prueba:
      - xxdescixx@gmail.com
      - angelxhernandezxcruz@gmail.com
    end note
  }
}

' ============================================
' RELACIONES - FRONTEND
' ============================================
user --> chatbox : "Interactúa"
user --> testpages : "Prueba flujos"
chatbox --> phpserver : "HTTP Requests"
testpages --> phpserver : "HTTP Requests"

' ============================================
' RELACIONES - API GATEWAY
' ============================================
phpserver --> apigateway : "POST /api/v1/nlp/process\nGET /api/v1/users/*\nPOST /api/v1/chat-sessions/*"

apigateway --> usersctrl : "Rutas /users"
apigateway --> passctrl : "Rutas /password-reset"
apigateway --> chatctrl : "Rutas /chat-sessions"
apigateway --> nlpctrl : "Rutas /nlp"
apigateway --> healthctrl : "Rutas /health"

usersctrl --> mysqlservice : "Verificar email"
passctrl --> passservice : "Iniciar/Confirmar\nrecuperación"
nlpctrl --> nlpservice_client : "Procesar mensaje"

mysqlservice --> mysql : "SELECT usuarios\nJOIN datos_personales"
passservice --> mongodb : "CRUD Tokens\nCRUD Notifications"

' ============================================
' RELACIONES - NLP SERVICE
' ============================================
nlpservice_client --> nlpservice : "HTTP :8001"
ngrok --> webhook_ctrl : "HTTPS Webhook\n/webhook"

nlp_ctrl --> process_msg : "Procesar mensaje"
webhook_ctrl --> process_msg : "Flujo DialogFlow"

process_msg --> hybrid_nlp : "Detectar intent"
process_msg --> context_mgr : "Gestionar contexto"

hybrid_nlp --> dialogflow : "Primary NLP"
hybrid_nlp --> local_nlp : "Fallback NLP"

dialogflow --> dialogflow_api : "detectIntent()\nHTTPS API"
dialogflow_api --> ngrok : "Webhook callback"

' ============================================
' RELACIONES - PASSWORD RESET FLOW
' ============================================
passservice --> notifservice : "POST /api/notifications/\nemail/password-reset-confirmation"
email_ctrl --> email_service : "Enviar email"
email_service --> gmail : "SMTP\nPort 587"
gmail -.-> user : "📧 Email con link\nde recuperación"

' ============================================
' RELACIONES - DATOS
' ============================================
chatctrl --> mongodb : "CRUD Sessions\nCRUD Messages"
nlpservice --> mongodb : "Cache de usuarios\nContexto conversación"

' ============================================
' FLUJO DE RECUPERACIÓN DE CONTRASEÑA (RF004)
' ============================================
note as N1
  **Flujo RF004 - Recuperación de Contraseña:**
  
  1. Usuario: "olvidé mi contraseña"
     → DialogFlow detecta intent
     → Webhook crea contexto "awaiting-email"
  
  2. Usuario: "xxdescixx@gmail.com"
     → Process Message detecta email (REGEX)
     → Llama handle_password_recovery_with_email()
  
  3. Verifica email en MySQL
     → SELECT email_personal FROM usuarios
  
  4. Si existe:
     → Genera token único (crypto.randomBytes)
     → Guarda en MongoDB (tokens_col)
     → Crea ValidationNotification (notif_col)
  
  5. Envía email via Notification Service
     → Template HTML con botón
     → URL: /api/v1/password-reset/confirm/:token
  
  6. Usuario hace clic en botón
     → Verifica token (no usado, no expirado)
     → Genera nueva contraseña segura
     → Actualiza en MySQL
     → Envía email con nueva contraseña
     → Marca token como usado
end note

N1 .. passservice
N1 .. webhook_ctrl
N1 .. mysqlservice

' ============================================
' LEYENDA
' ============================================
legend right
  |<#LightBlue> | Capa de Presentación |
  |<#LightGreen> | API Gateway (Puerto 3000) |
  |<#LightCyan> | Microservicios |
  |<#LightSalmon> | Capa de Datos |
  |<#LightGray> | Servicios Externos |
  |<#Orange> | Túnel HTTPS (ngrok) |
  
  **Puertos:**
  - Frontend PHP: 8000
  - API Gateway: 3000
  - NLP Service: 8001
  - Notification Service: 3005
  - ngrok Dashboard: 4040
  
  **Tecnologías:**
  - Frontend: HTML/CSS/JavaScript + PHP
  - API Gateway: NestJS + TypeScript
  - NLP Service: Python + FastAPI
  - Notification Service: NestJS + NodeMailer
  - Bases de datos: MongoDB + MySQL
  - DialogFlow: ES (Essential)
endlegend

@enduml
