{
    # Debug
    {$DEBUG}
}

{$SERVER_NAME}

root * /app/public

# Enable compression
encode gzip

# PHP files
php_fastcgi unix//tmp/php.sock

# Handle PHP files
@php {
    path *.php
}
handle @php {
    try_files {path} {path}/ /index.php
    php_fastcgi unix//tmp/php.sock
}

# Handle static files
handle {
    try_files {path} {path}/ /index.php
    php_fastcgi unix//tmp/php.sock
}

# Health check
handle /api/v1/health {
    respond "OK" 200
}
